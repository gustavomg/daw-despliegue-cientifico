# Copia este fichero a ".env" (dentro de backend/) SOLO si vas a ejecutar el backend en local,
# fuera de Docker. Cuando se despliega con docker-compose.yml, estas variables ya se inyectan
# automáticamente desde el .env de la raíz del proyecto.
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=climared
PGPASSWORD=climared
PGDATABASE=climared

# --- Redis (buffer pub/sub) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL=climared:lecturas

# --- Retención y persistencia ---
# Días a partir de los cuales una lectura se considera "antigua" y se purga de Postgres.
RETENCION_DIAS=30
# Cada cuánto se vuelca a Postgres el buffer de lecturas recibidas por Redis (ms).
BATCH_INTERVAL_MS=5000
# Cada cuánto se ejecuta el proceso de purga de retención (ms). 3600000 = 1 hora.
PURGA_INTERVALO_MS=3600000
