# Copia este fichero a ".env" en la raíz del proyecto antes de "docker compose up".
# Todas estas variables se inyectan a los distintos servicios vía docker-compose.yml.

# --- Base de datos PostgreSQL ---
PGUSER=climared
PGPASSWORD=climared
PGDATABASE=climared

# --- Simulador de sensores (sensor-sim) ---
# Número de estaciones que genera el simulador. Debe coincidir con las estaciones sembradas
# en backend/sql/init.sql (por defecto 5): si se sube por encima de 5, las lecturas de las
# estaciones "extra" se descartarán en el backend al no existir esa estacion_id en la BD
# (ver documentacion/Guia_Despliegue_y_Ejercicios_Cientifico.docx, sección "Diagnóstico de errores").
NUM_ESTACIONES=5
# Intervalo entre tandas de lecturas, en milisegundos. Se puede cambiar sin reconstruir
# la imagen: basta con editar este fichero y ejecutar "docker compose up -d" de nuevo.
INTERVALO_MS=3000

# --- Retención de datos históricos (backend) ---
# Los registros de la tabla "lecturas" con más de RETENCION_DIAS días se purgan automáticamente
# de forma periódica (ver backend/src/server.js).
RETENCION_DIAS=30

# --- Nginx (puerta de entrada HTTP) ---
HTTP_PORT=80

# --- Monitorización opcional (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_PASSWORD=admin
